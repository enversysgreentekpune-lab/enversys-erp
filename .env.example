# --- Database ---
DATABASE_URL=postgres://enversys:enversys@localhost:5432/enversys
# --- Auth ---
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
SESSION_DAYS=30
# OTP provider: console (dev: OTP printed to server log & shown on login screen) | msg91 | twilio
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# --- Email --- (leave SMTP_HOST empty in dev: emails are stored + rendered to storage/outbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Enversys Sales <sales@enversys.com>"
INBOUND_WEBHOOK_SECRET=change-me
WEBSITE_LEAD_SECRET=change-me
# --- Storage --- local | s3  (s3 uses the S3_* vars)
STORAGE_DRIVER=local
STORAGE_DIR=./storage
APP_URL=http://localhost:3000
